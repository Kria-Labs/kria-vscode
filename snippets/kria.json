{
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:functionName}(${2:parameters}) {",
      "\t$3",
      "\treturn $4",
      "}"
    ],
    "description": "Define a function"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t$2",
      "}"
    ],
    "description": "While loop"
  },
  "For-In Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:array} {",
      "\t$3",
      "}"
    ],
    "description": "For-in loop for arrays"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t$2",
      "}"
    ],
    "description": "If statement"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "\t$2",
      "} else {",
      "\t$3",
      "}"
    ],
    "description": "If-else statement"
  },
  "If-Elseif-Else Statement": {
    "prefix": "ifelseif",
    "body": [
      "if (${1:condition1}) {",
      "\t$2",
      "} elseif (${3:condition2}) {",
      "\t$4",
      "} else {",
      "\t$5",
      "}"
    ],
    "description": "If-elseif-else statement"
  },
  "Variable Declaration": {
    "prefix": "set",
    "body": [
      "set ${1:variableName} = ${2:value}"
    ],
    "description": "Declare a variable"
  },
  "String Input": {
    "prefix": "inputstr",
    "body": [
      "set ${1:variable} = input<str>(\"${2:prompt}\")"
    ],
    "description": "Get string input from user"
  },
  "Integer Input": {
    "prefix": "inputint",
    "body": [
      "set ${1:variable} = input<int>(\"${2:prompt}\")"
    ],
    "description": "Get integer input from user"
  },
  "Float Input": {
    "prefix": "inputfloat",
    "body": [
      "set ${1:variable} = input<float>(\"${2:prompt}\")"
    ],
    "description": "Get float input from user"
  },
  "Numeric or String Input": {
    "prefix": "inputunion",
    "body": [
      "set ${1:value} = input<int|float|str>(\"${2:Value: }\")"
    ],
    "description": "Accept an integer, float, or string from user input"
  },
  "Print Statement": {
    "prefix": "print",
    "body": [
      "print(${1:value})"
    ],
    "description": "Print to console"
  },
  "Array": {
    "prefix": "arr",
    "body": [
      "set ${1:arrayName} = [${2:1, 2, 3}]"
    ],
    "description": "Create a mutable array"
  },
  "Immutable Array": {
    "prefix": "immarr",
    "body": [
      "set ${1:arrayName} = #[${2:1, 2, 3}]"
    ],
    "description": "Create an immutable array"
  },
  "Object": {
    "prefix": "obj",
    "body": [
      "set ${1:objectName} = { ${2:key}: \"${3:value}\" }"
    ],
    "description": "Create an object"
  },
  "Push to Array": {
    "prefix": "push",
    "body": [
      "push(${1:array}, ${2:value})"
    ],
    "description": "Add element to array"
  },
  "Pop from Array": {
    "prefix": "pop",
    "body": [
      "set ${1:variable} = pop(${2:array})"
    ],
    "description": "Remove last element from array"
  },
  "Remove Property": {
    "prefix": "rmv",
    "body": [
      "rmv(${1:object.property})"
    ],
    "description": "Remove property from object"
  },
  "Get Type": {
    "prefix": "type",
    "body": [
      "type(${1:value})"
    ],
    "description": "Get the type of a value"
  },
  "Wait": {
    "prefix": "wait",
    "body": [
      "wait(${1:1000})"
    ],
    "description": "Pause execution for milliseconds"
  },
  "For-In Object Loop": {
    "prefix": "forobj",
    "body": [
      "for ${1:key}, ${2:value} in ${3:object} {",
      "\t$4",
      "}"
    ],
    "description": "For-in loop for objects (key-value pairs)"
  },
  "Early Return": {
    "prefix": "guard",
    "body": [
      "if (${1:condition}) {",
      "\treturn ${2:value}",
      "}"
    ],
    "description": "Early return guard clause"
  },
  "Object Iteration": {
    "prefix": "iterobj",
    "body": [
      "for key, value in ${1:object} {",
      "\tprint(key)",
      "\tprint(value)",
      "}"
    ],
    "description": "Iterate over object key-value pairs"
  },
  "Array Iteration": {
    "prefix": "iterarr",
    "body": [
      "for item in ${1:array} {",
      "\tprint(item)",
      "}"
    ],
    "description": "Iterate over array items"
  },
  "Nested Function": {
    "prefix": "fnested",
    "body": [
      "fn ${1:outerFunction}() {",
      "\tfn ${2:innerFunction}() {",
      "\t\t$3",
      "\t}",
      "\t$4",
      "}"
    ],
    "description": "Function containing nested function"
  },
  "Multi-line String": {
    "prefix": "str3",
    "body": [
      "set ${1:text} = \"\"\"",
      "${2:multi-line}",
      "${3:string content}",
      "\"\"\""
    ],
    "description": "Multi-line string literal"
  },
  "Block Comment": {
    "prefix": "cmt",
    "body": [
      "/*",
      " * ${1:comment}",
      " */"
    ],
    "description": "Block comment"
  },
  "Type Check": {
    "prefix": "typeof",
    "body": [
      "set ${1:varType} = type(${2:variable})"
    ],
    "description": "Check type of variable"
  },
  "Delay Execution": {
    "prefix": "delay",
    "body": [
      "wait(${1:1000})",
      "$2"
    ],
    "description": "Add delay with wait()"
  },
  "Object Property Access": {
    "prefix": "prop",
    "body": [
      "${1:object}.${2:property}"
    ],
    "description": "Access object property"
  },
  "Array Element Access": {
    "prefix": "elem",
    "body": [
      "${1:array}[${2:0}]"
    ],
    "description": "Access array element"
  },
  "Modify Array Element": {
    "prefix": "setelement",
    "body": [
      "${1:array}[${2:0}] = ${3:value}"
    ],
    "description": "Modify array element at index"
  },
  "Inline Conditional": {
    "prefix": "ifcond",
    "body": [
      "if (${1:condition}) { ${2:action} }"
    ],
    "description": "Single-line if statement"
  },
  "Lambda-like Anonymous Function": {
    "prefix": "anon",
    "body": [
      "set ${1:func} = fn(${2:param}) { return ${3:result} }"
    ],
    "description": "Anonymous function"
  },
  "Recursive Function": {
    "prefix": "fnrec",
    "body": [
      "fn ${1:recursive}(${2:n}) {",
      "\tif (${3:n} <= 1) {",
      "\t\treturn ${4:base}",
      "\t}",
      "\treturn ${5:recursive}(${2:n} - 1)",
      "}"
    ],
    "description": "Recursive function template"
  },
  "Export Function": {
    "prefix": "expfn",
    "body": [
      "export fn ${1:functionName}(${2:parameters}) {",
      "\t$3",
      "\treturn $4",
      "}"
    ],
    "description": "Export a function"
  },
  "Import Module": {
    "prefix": "imp",
    "body": [
      "import ${1:moduleName} from \"${2:./path.krx}\""
    ],
    "description": "Import a module"
  }
}
