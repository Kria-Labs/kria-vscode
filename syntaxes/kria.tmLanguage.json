{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Kria",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#function-declarations"
		},
		{
			"include": "#variable-declarations"
		},
		{
			"include": "#for-in-object"
		},
		{
			"include": "#loop-bindings"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#generics"
		},
		{
			"include": "#array-assignment"
		},
		{
			"include": "#builtins"
		},
		{
			"include": "#function-calls"
		},
		{
			"include": "#arrays"
		},
		{
			"include": "#objects"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#booleans"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#logical-operators"
		}
	],
	"repository": {
		"function-declarations": {
			"patterns": [
				{
					"name": "meta.function.kria",
					"match": "\\b(export\\s+)?(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "keyword.control.kria" },
						"2": { "name": "keyword.control.kria" },
						"3": { "name": "entity.name.function.kria" }
					}
				}
			]
		},
		"variable-declarations": {
			"patterns": [
				{
					"name": "meta.variable.declaration.kria",
					"match": "\\b(set)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "keyword.control.kria" },
						"2": { "name": "variable.other.kria" }
					}
				}
			]
		},
		"loop-bindings": {
			"patterns": [
				{
					"name": "meta.loop.kria",
					"match": "\\b(for)\\s+(?:([A-Za-z_][A-Za-z0-9_]*)\\s*,\\s*)?([A-Za-z_][A-Za-z0-9_]*)\\s+(in)\\b",
					"captures": {
						"1": { "name": "keyword.control.kria" },
						"2": { "name": "variable.other.kria" },
						"3": { "name": "variable.other.kria" },
						"4": { "name": "keyword.control.kria" }
					}
				}
			]
		},
		"function-calls": {
			"patterns": [
				{
					"name": "entity.name.function.kria",
					"match": "\\b(?!if\\b|elseif\\b|else\\b|while\\b|for\\b|in\\b|fn\\b|set\\b|return\\b|break\\b|continue\\b|export\\b|import\\b|from\\b)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.kria",
					"match": "//.*$"
				},
				{
					"name": "comment.block.kria",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.kria",
					"match": "\\b(if|elseif|else|while|for|in|fn|set|return|break|continue|export|import|from)\\b"
				}
			]
		},
		"builtins": {
			"patterns": [
				{
					"name": "support.function.builtin.kria",
					"match": "\\b(print|input|push|pop|rmv|type|wait)\\b"
				},
				{
					"name": "support.other.kria",
					"match": "\\.(length)\\b"
				}
			]
		},
		"generics": {
			"patterns": [
				{
					"name": "meta.input.type.kria",
					"begin": "\\binput\\s*(?=<)",
					"beginCaptures": {
						"0": { "name": "support.function.builtin.kria" }
					},
					"end": ">",
					"patterns": [
						{
							"name": "entity.name.type.kria",
							"match": "\\b(str|int|float)\\b"
						}
					]
				}
			]
		},
		"arrays": {
			"patterns": [
				{
					"name": "meta.array.immutable.kria",
					"begin": "#\\[",
					"end": "\\]",
					"patterns": [
						{ "include": "#comments" },
						{ "include": "#strings" },
						{ "include": "#numbers" },
						{ "include": "#booleans" },
						{ "include": "#arrays" },
						{ "include": "#objects" },
						{ "include": "#generics" },
						{ "include": "#builtins" },
						{ "include": "#function-calls" },
						{ "include": "#logical-operators" },
						{ "include": "#operators" }
					]
				},
				{
					"name": "meta.array.access.kria",
					"match": "\\[\\s*\\d+\\s*\\]"
				},
				{
					"name": "meta.array.kria",
					"begin": "\\[",
					"end": "\\]",
					"patterns": [
						{ "include": "#comments" },
						{ "include": "#strings" },
						{ "include": "#numbers" },
						{ "include": "#booleans" },
						{ "include": "#arrays" },
						{ "include": "#objects" },
						{ "include": "#generics" },
						{ "include": "#builtins" },
						{ "include": "#function-calls" },
						{ "include": "#logical-operators" },
						{ "include": "#operators" }
					]
				}
			]
		},
		"objects": {
			"patterns": [
				{
					"name": "meta.object.kria",
					"begin": "\\{",
					"end": "\\}",
					"patterns": [
						{
							"name": "variable.other.property.kria",
							"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:"
						},
						{ "include": "#comments" },
						{ "include": "#strings" },
						{ "include": "#numbers" },
						{ "include": "#booleans" },
						{ "include": "#arrays" },
						{ "include": "#objects" },
						{ "include": "#builtins" },
						{ "include": "#logical-operators" },
						{ "include": "#operators" }
					]
				},
				{
					"name": "meta.object.property.kria",
					"match": "\\.(\\w+)"
				},
				{
					"name": "meta.object.bracket.access.kria",
					"match": "\\[\\s*['\"]\\w+['\"]\\s*\\]"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.kria",
					"match": "(\\+|-|\\*|/|==|!=|>=|<=|>|<|=)"
				}
			]
		},
		"logical-operators": {
			"patterns": [
				{
					"name": "keyword.operator.logical.kria",
					"match": "\\b(and|or|not)\\b"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.triple.kria",
					"begin": "\"\"\"",
					"end": "\"\"\"",
					"patterns": [
						{
							"name": "constant.character.escape.kria",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.double.kria",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.kria",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.kria",
					"match": "(?<![\\w.])(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?(?![\\w.])"
				}
			]
		},
		"booleans": {
			"patterns": [
				{
					"name": "constant.language.kria",
					"match": "\\b(true|false|null)\\b"
				}
			]
		},
		"for-in-object": {
			"patterns": [
				{
					"name": "meta.for-in-object.kria",
					"match": "\\bfor\\s+(\\w+)\\s*,\\s*(\\w+)\\s+in\\b",
					"captures": {
						"1": { "name": "variable.other.kria" },
						"2": { "name": "variable.other.kria" }
					}
				}
			]
		},
		"array-assignment": {
			"patterns": [
				{
					"name": "meta.array.assignment.kria",
					"match": "(\\w+)\\[(\\d+)\\]\\s*=",
					"captures": {
						"1": { "name": "variable.other.kria" },
						"2": { "name": "constant.numeric.kria" }
					}
				}
			]
		}
	},
	"scopeName": "source.kria"
}